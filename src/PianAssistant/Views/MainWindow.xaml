<Window x:Class="PianAssistant.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:views="clr-namespace:PianAssistant.Views"
        xmlns:ctrl="clr-namespace:PianAssistant.Views.Controls"
        Title="拉片助手 — PianAssistant"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="#0F0F0F"
        Foreground="#E8E8E8"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13">

    <Window.Resources>
        <!-- 按钮基础样式 -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3D3D3D" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#505050" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#606060" />
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 强调色按钮 -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Background" Value="#1A6B8A" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2480A0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 导航标签按钮 -->
        <Style x:Key="NavTab" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#999999" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Rectangle x:Name="underline" Height="2" VerticalAlignment="Bottom"
                                          Fill="#1A6B8A" RadiusX="1" RadiusY="1"
                                          Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E0E0E0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 滑块样式：使用默认模板，仅覆盖颜色 -->
        <Style x:Key="PlayerSlider" TargetType="Slider">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#1A6B8A" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Height" Value="20" />
        </Style>
    </Window.Resources>

    <!-- 键盘绑定改由 HotkeyService 动态构建（见 MainWindow.xaml.cs RebuildInputBindings），
         以便设置窗的自定义快捷键真正生效；方向键长按仍由 PreviewKeyDown/Up 处理。 -->

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />    <!-- 顶部导航栏 -->
            <RowDefinition Height="*" />     <!-- 视频内容区 -->
            <RowDefinition Height="50" />    <!-- 时间轴（固定，预留滚动条，避免跳动） -->
            <RowDefinition Height="56" />    <!-- 底部控制栏 -->
        </Grid.RowDefinitions>

        <!-- ═══ 顶部导航栏 ═══ -->
        <Border x:Name="TopNavBorder" Grid.Row="0" Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- W1-R1-01 Logo + 标题 -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <Border Width="28" Height="28" CornerRadius="14" Background="#1A6B8A" Margin="0,0,10,0">
                        <TextBlock Text="P" Foreground="White" FontWeight="Bold" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="拉片助手" Foreground="#E8E8E8" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- W1-R1-16 打开视频（左侧，紧跟 Logo） -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="� 打开视频" Style="{StaticResource AccentButton}" Padding="12,6"
                            Command="{Binding OpenFileCommand}"
                            ToolTip="打开视频文件（右键查看最近文件）">
                        <Button.ContextMenu>
                            <!-- 最近文件列表（打开时动态填充，见 OnRecentFilesMenuOpened） -->
                            <ContextMenu x:Name="RecentFilesMenu" Opened="OnRecentFilesMenuOpened" />
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <!-- W1-R1-23 展开/收起左侧播放列表（打开视频右侧） -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                    <Button Content="📑" Style="{StaticResource IconButton}" Padding="10,6" FontSize="16"
                            Command="{Binding TogglePlaylistVisibilityCommand}"
                            ToolTip="展开/收起播放列表" />
                </StackPanel>

                <!-- W1-R1-24 展开/收起右侧侧边栏（最右端） -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <Button Content="�" Style="{StaticResource IconButton}" Padding="10,6" FontSize="16"
                            Command="{Binding ToggleSidebarVisibilityCommand}"
                            ToolTip="展开/收起侧边栏" />
                </StackPanel>

                <!-- W1-R1-17 设置（侧边栏开关左侧） -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⚙" Style="{StaticResource IconButton}" Padding="10,6"
                            Command="{Binding OpenSettingsCommand}" FontSize="16" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ 视频内容区 ═══ -->
        <Grid x:Name="ContentGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左侧播放列表（可收起，W1-C1；默认收起） -->
            <Grid Grid.Column="0" Visibility="{Binding IsPlaylistVisible, Converter={x:Static views:BoolToVisibilityConverter.Instance}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="160" MaxWidth="400" />
                    <ColumnDefinition Width="6" />
                </Grid.ColumnDefinitions>
                <views:PlaylistView Grid.Column="0" DataContext="{Binding Playlist}" />
                <GridSplitter x:Name="PlaylistSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                              Background="#1A1A1A" ResizeBehavior="PreviousAndNext" />
            </Grid>

            <!-- 视频区 -->
            <Grid x:Name="VideoArea" Grid.Column="1" Background="#000000"
                  AllowDrop="True" Drop="OnVideoDrop" DragOver="OnVideoDragOver">
                <vlc:VideoView x:Name="VideoView" />

                <!-- 方向键视觉反馈叠加层 -->
                <Border x:Name="ArrowFeedbackOverlay" HorizontalAlignment="Center"
                        VerticalAlignment="Center" IsHitTestVisible="False"
                        Visibility="Collapsed" Opacity="0">
                    <Border.Background>
                        <SolidColorBrush Color="Black" Opacity="0.75" />
                    </Border.Background>
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="ArrowFeedbackScale" ScaleX="1" ScaleY="1" />
                    </Border.RenderTransform>
                    <Border.RenderTransformOrigin>
                        <Point X="0.5" Y="0.5" />
                    </Border.RenderTransformOrigin>
                    <StackPanel Margin="20,12" HorizontalAlignment="Center">
                        <TextBlock x:Name="ArrowFeedbackIcon" FontSize="36" Foreground="White"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="ArrowFeedbackText" FontFamily="Consolas" FontSize="18"
                                   Foreground="#4EC9B0" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- 无视频时的大播放按钮叠加层 -->
                <Border x:Name="EmptyStateOverlay" Background="#000000" Opacity="0.85"
                        Visibility="{Binding Player.HasMedia, Converter={x:Static views:InverseBoolToVisibilityConverter.Instance}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="72" Height="72" CornerRadius="36" Background="#1A6B8A"
                                HorizontalAlignment="Center" Margin="0,0,0,16" Opacity="0.8">
                            <TextBlock Text="▶" Foreground="White" FontSize="32"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="4,0,0,0" />
                        </Border>
                        <TextBlock Text="点击「打开文件」加载视频" Foreground="#808080" FontSize="14"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 右侧侧边栏（可收起，W1-C2/C3；默认收起） -->
            <Grid Grid.Column="2" Visibility="{Binding IsSidebarVisible, Converter={x:Static views:BoolToVisibilityConverter.Instance}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="300" MinWidth="200" MaxWidth="500" />
                </Grid.ColumnDefinitions>
                <GridSplitter x:Name="SidebarSplitter" Grid.Column="0" Width="6" HorizontalAlignment="Stretch"
                              Background="#1A1A1A" ResizeBehavior="PreviousAndNext" />

                <!-- 右侧面板 -->
                <DockPanel x:Name="SidebarPanel" Grid.Column="1" Background="#161616">
                    <!-- 面板标题 -->
                    <Border DockPanel.Dock="Top" Background="#1A1A1A" Padding="16,10"
                            BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
                        <TextBlock Text="{Binding ActivePanelTitle}" Foreground="#E8E8E8"
                                   FontWeight="SemiBold" FontSize="13" />
                    </Border>

                    <Grid>
                        <views:NotesView DataContext="{Binding Notes}">
                            <views:NotesView.Visibility>
                                <Binding Path="DataContext.ActivePanel"
                                         RelativeSource="{RelativeSource AncestorType=Window}"
                                         Converter="{x:Static views:PanelToVisibilityConverter.Instance}"
                                         ConverterParameter="Notes" />
                            </views:NotesView.Visibility>
                        </views:NotesView>
                        <!-- 片段批量导出面板（M4） -->
                        <views:ClipsView DataContext="{Binding Clips}">
                            <views:ClipsView.Visibility>
                                <Binding Path="DataContext.ActivePanel"
                                         RelativeSource="{RelativeSource AncestorType=Window}"
                                         Converter="{x:Static views:PanelToVisibilityConverter.Instance}"
                                         ConverterParameter="Clips" />
                            </views:ClipsView.Visibility>
                        </views:ClipsView>
                    </Grid>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- ═══ 时间轴 ═══ -->
        <Border x:Name="TimelineBorder" Grid.Row="2" Background="#1A1A1A"
                BorderBrush="#2A2A2A" BorderThickness="0,1,0,1">
            <DockPanel>
                <!-- 缩放指示 -->
                <Border DockPanel.Dock="Right" Background="#2A2A2A" Padding="8,0" Margin="4,0,0,0"
                        VerticalAlignment="Stretch">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Text="缩放" Foreground="#888888" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock x:Name="ZoomLabel" Text="1.0×" Foreground="#CCCCCC" FontSize="11"
                                   FontFamily="Consolas" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>
                </Border>
                <!-- 可滚动时间轴 -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Background="#1A1A1A"
                              SizeChanged="OnTimelineScrollSizeChanged"
                              x:Name="TimelineScroll">
                    <ctrl:TimelineControl
                        Height="32"
                        Margin="0,2,0,0"
                        PositionRatio="{Binding Player.PositionRatio, Mode=OneWay}"
                        Length="{Binding Player.Length}"
                        InPoint="{Binding Player.InPoint}"
                        OutPoint="{Binding Player.OutPoint}"
                        CutPoints="{Binding Player.CutPoints}"
                        Markers="{Binding Notes.Markers}"
                        SelectedSegmentStart="{Binding Player.SelectedSegmentStart, Mode=OneWay}"
                        SelectedSegmentEnd="{Binding Player.SelectedSegmentEnd, Mode=OneWay}"
                        SeekRequested="OnTimelineSeek"
                        SegmentSelected="OnTimelineSegmentSelected"
                        ScaleChanged="OnTimelineScaleChanged" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ═══ 底部控制栏 ═══ -->
        <Border x:Name="BottomControlBorder" Grid.Row="3" Background="#1A1A1A">
            <DockPanel LastChildFill="True" Margin="16,0">
                <!-- 左侧：时间码 / 倍速标记 / 音量 / 全屏 -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- W1-R4-01 当前时间码 -->
                    <TextBlock Text="{Binding Player.TimeCodeDisplayString}" Foreground="#E8E8E8"
                               FontFamily="Consolas" FontSize="11" />
                    <TextBlock Text=" / " Foreground="#666666" FontFamily="Consolas" FontSize="11" Margin="2,0" />
                    <!-- W1-R4-02 总时长 -->
                    <TextBlock Text="{Binding Player.LengthDisplayString}" Foreground="#999999"
                               FontFamily="Consolas" FontSize="11" />
                    <!-- W1-R4-03 倍速标记（非1.0×时显示，点击恢复1×） -->
                    <Button Style="{StaticResource IconButton}" Padding="0" Margin="10,0,0,0"
                            Command="{Binding Player.ResetRateCommand}"
                            Visibility="{Binding Player.IsRateNormal, Converter={x:Static views:InverseBoolToVisibilityConverter.Instance}}"
                            ToolTip="点击恢复 1× 倍速">
                        <Border Padding="6,2" CornerRadius="3" Background="#1A6B8A">
                            <TextBlock Text="{Binding Player.RateText}" Foreground="White"
                                       FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                    </Button>
                    <!-- W1-R4-04 静音 -->
                    <Button Content="🔊" Style="{StaticResource IconButton}" Padding="6,4" FontSize="15"
                            Margin="10,0,0,0"
                            Command="{Binding Player.ToggleMuteCommand}" ToolTip="静音 (M)" />
                    <!-- W1-R4-05 音量滑块 -->
                    <Slider Minimum="0" Maximum="100" Style="{StaticResource PlayerSlider}"
                            Value="{Binding Player.Volume, Mode=TwoWay}"
                            Width="80" VerticalAlignment="Center" Margin="4,0,8,0"
                            ToolTip="音量" />
                    <!-- W1-R4-06 音量百分比 -->
                    <TextBlock Text="{Binding Player.Volume, StringFormat={}{0}%}" Foreground="#999999"
                               FontFamily="Consolas" FontSize="12" MinWidth="30" VerticalAlignment="Center" />
                    <!-- W1-R4-08 全屏 -->
                    <Button Content="⛶" Style="{StaticResource IconButton}" Padding="6,4" FontSize="18"
                            Command="{Binding Player.ToggleFullscreenCommand}" ToolTip="全屏 (F)" />
                </StackPanel>

                <!-- 右侧：从 R1 移入的功能按钮（截图 / 截取片段 / 撤销裁切 / 清空裁切） -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- W1-R1-05 截图 -->
                    <Button Content="📷" Style="{StaticResource IconButton}" Padding="8,6" FontSize="16"
                            Command="{Binding Player.CaptureScreenshotCommand}" ToolTip="截图 (S)" />
                    <!-- W1-R1-08 截取片段 -->
                    <Button Content="✂" Style="{StaticResource IconButton}" Padding="8,6" FontSize="16"
                            Command="{Binding Player.ExtractClipCommand}" ToolTip="截取片段 (Ctrl+Shift+E)" />
                    <!-- W1-R1-10 撤销裁切点 -->
                    <Button Content="↩" Style="{StaticResource IconButton}" Padding="8,6" FontSize="16"
                            Command="{Binding Player.RemoveLastCutPointCommand}" ToolTip="撤销裁切点 (Backspace)" />
                    <!-- W1-R1-11 清空裁切点 -->
                    <Button Content="✖" Style="{StaticResource IconButton}" Padding="8,6" FontSize="16"
                            Command="{Binding Player.ClearCutPointsCommand}" ToolTip="清空裁切点 (Ctrl+Shift+C)" />
                </StackPanel>

                <!-- 中间：播放控制（左右对称排列） -->
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- W1-R4-09 跳到开头 -->
                    <Button Grid.Column="0" Content="⏮" Style="{StaticResource IconButton}"
                            Padding="10,6" FontSize="18"
                            Command="{Binding Player.SeekToStartCommand}" ToolTip="跳到开头 (Home)" />
                    <!-- W1-R4-14 降低倍速 -->
                    <Button Grid.Column="1" Content="−" Style="{StaticResource IconButton}"
                            Padding="10,6" FontSize="16" FontWeight="Bold"
                            Command="{Binding Player.DecreaseRateCommand}" ToolTip="降低倍速" />
                    <!-- W1-R4-10 上一帧 -->
                    <Button Grid.Column="2" Content="◀" Style="{StaticResource IconButton}"
                            Padding="10,6" FontSize="16"
                            Command="{Binding Player.PreviousFrameCommand}" ToolTip="上一帧 (←)" />
                    <!-- W1-R4-11 播放/暂停（居中，大圆钮） -->
                    <Border Grid.Column="3" Width="44" Height="44" CornerRadius="22"
                            Background="#1A6B8A" Margin="4,0">
                        <Button Content="⏯" Style="{StaticResource AccentButton}" Padding="0" FontSize="20"
                                Command="{Binding Player.PlayPauseCommand}" ToolTip="播放/暂停 (Space)"
                                Width="44" Height="44" />
                    </Border>
                    <!-- W1-R4-12 下一帧 -->
                    <Button Grid.Column="4" Content="▶" Style="{StaticResource IconButton}"
                            Padding="10,6" FontSize="16"
                            Command="{Binding Player.NextFrameCommand}" ToolTip="下一帧 (→)" />
                    <!-- W1-R4-15 提高倍速 -->
                    <Button Grid.Column="5" Content="+" Style="{StaticResource IconButton}"
                            Padding="10,6" FontSize="16" FontWeight="Bold"
                            Command="{Binding Player.IncreaseRateCommand}" ToolTip="提高倍速" />
                    <!-- W1-R4-13 跳到结尾 -->
                    <Button Grid.Column="6" Content="⏭" Style="{StaticResource IconButton}"
                            Padding="10,6" FontSize="18"
                            Command="{Binding Player.SeekToEndCommand}" ToolTip="跳到结尾 (End)" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- ═══ 右下角提示条（M7 静默恢复提示，不弹窗打断）═══ -->
        <Border x:Name="ToastBorder" Grid.RowSpan="4"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,20,20" Padding="14,10" CornerRadius="6" MaxWidth="420"
                Background="#E01A6B8A" BorderBrush="#2480A0" BorderThickness="1"
                IsHitTestVisible="False" Visibility="Collapsed" Opacity="0">
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="13" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
