<Window x:Class="PianAssistant.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:views="clr-namespace:PianAssistant.Views"
        xmlns:ctrl="clr-namespace:PianAssistant.Views.Controls"
        Title="拉片助手 — PianAssistant"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="#E0E0E0"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13">

    <Window.InputBindings>
        <KeyBinding Key="Space" Command="{Binding Player.PlayPauseCommand}" />
        <KeyBinding Key="Right" Command="{Binding Player.NextFrameCommand}" />
        <KeyBinding Key="Left" Command="{Binding Player.PreviousFrameCommand}" />
        <KeyBinding Gesture="Shift+Left" Command="{Binding Player.SeekBackward1SecondCommand}" />
        <KeyBinding Gesture="Shift+Right" Command="{Binding Player.SeekForward1SecondCommand}" />
        <KeyBinding Gesture="Ctrl+Left" Command="{Binding Player.SeekBackward10SecondsCommand}" />
        <KeyBinding Gesture="Ctrl+Right" Command="{Binding Player.SeekForward10SecondsCommand}" />
        <KeyBinding Key="Home" Command="{Binding Player.SeekToStartCommand}" />
        <KeyBinding Key="End" Command="{Binding Player.SeekToEndCommand}" />
        <KeyBinding Key="OemPlus" Command="{Binding Player.IncreaseRateCommand}" />
        <KeyBinding Key="OemMinus" Command="{Binding Player.DecreaseRateCommand}" />
        <KeyBinding Key="I" Command="{Binding Player.MarkInCommand}" />
        <KeyBinding Key="O" Command="{Binding Player.MarkOutCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+I" Command="{Binding Player.ClearInOutCommand}" />
        <KeyBinding Key="S" Command="{Binding Player.CaptureScreenshotCommand}" />
        <KeyBinding Key="C" Command="{Binding Player.ExtractClipCommand}" />
        <KeyBinding Key="F" Command="{Binding Player.ToggleFullscreenCommand}" />
        <KeyBinding Key="Escape" Command="{Binding Player.ExitFullscreenCommand}" />
        <KeyBinding Key="L" Command="{Binding Player.ToggleLoopCommand}" />
        <KeyBinding Key="M" Command="{Binding Player.ToggleMuteCommand}" />
        <KeyBinding Gesture="Ctrl+Up" Command="{Binding Player.VolumeUpCommand}" />
        <KeyBinding Gesture="Ctrl+Down" Command="{Binding Player.VolumeDownCommand}" />
        <KeyBinding Key="Tab" Command="{Binding ToggleSidebarPanelCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- A1: Top toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#2D2D2D">
            <Button Content="📂 打开" Command="{Binding OpenFileCommand}" Padding="12,4" Margin="2" />
            <Separator Margin="4,2" Background="#3F3F46" />
            <Button Content="⏮" Command="{Binding Player.PreviousFrameCommand}" Padding="8,4" Margin="2" />
            <Button Content="⏯" Command="{Binding Player.PlayPauseCommand}" Padding="8,4" Margin="2" />
            <Button Content="⏭" Command="{Binding Player.NextFrameCommand}" Padding="8,4" Margin="2" />
            <Separator Margin="4,2" Background="#3F3F46" />
            <Button Content="◄ 入点" Command="{Binding Player.MarkInCommand}" Padding="8,4" Margin="2" />
            <Button Content="出点 ►" Command="{Binding Player.MarkOutCommand}" Padding="8,4" Margin="2" />
            <Button Content="✖" Command="{Binding Player.ClearInOutCommand}" Padding="8,4" Margin="2" />
            <Separator Margin="4,2" Background="#3F3F46" />
            <Button Content="📷 截图" Command="{Binding Player.CaptureScreenshotCommand}" Padding="8,4" Margin="2" />
            <Button Content="✂ 截取" Command="{Binding Player.ExtractClipCommand}" Padding="8,4" Margin="2" />
            <Separator Margin="4,2" Background="#3F3F46" />
            <Button Content="🔁" Command="{Binding Player.ToggleLoopCommand}" Padding="8,4" Margin="2" />
            <Separator Margin="4,2" Background="#3F3F46" />
            <!-- 音量控制 -->
            <Button Content="🔊" Command="{Binding Player.ToggleMuteCommand}" Padding="8,4" Margin="2" />
            <Slider Minimum="0" Maximum="100"
                    Value="{Binding Player.Volume, Mode=TwoWay}"
                    Width="100" VerticalAlignment="Center" Margin="4,0"
                    ToolTip="音量 (M 静音, Ctrl+Up/Down 调节)" />
            <TextBlock Text="{Binding Player.Volume, StringFormat={}{0}%}"
                       VerticalAlignment="Center" Margin="2,0,8,0"
                       FontFamily="Consolas" MinWidth="34" />
            <Separator Margin="4,2" Background="#3F3F46" />
            <!-- 倍速选择 -->
            <TextBlock Text="速度:" VerticalAlignment="Center" Margin="8,0,2,0" />
            <ComboBox x:Name="RateComboBox" Width="70" Margin="2"
                      SelectedValue="{Binding Player.Rate, Mode=TwoWay}"
                      SelectedValuePath="Tag">
                <ComboBoxItem Content="0.25×" Tag="0.25" />
                <ComboBoxItem Content="0.5×" Tag="0.5" />
                <ComboBoxItem Content="0.75×" Tag="0.75" />
                <ComboBoxItem Content="1.0×" Tag="1" IsSelected="True" />
                <ComboBoxItem Content="1.25×" Tag="1.25" />
                <ComboBoxItem Content="1.5×" Tag="1.5" />
                <ComboBoxItem Content="2.0×" Tag="2" />
                <ComboBoxItem Content="4.0×" Tag="4" />
            </ComboBox>
            <Separator Margin="4,2" Background="#3F3F46" />
            <Button Content="⚙ 设置" Command="{Binding OpenSettingsCommand}" Padding="8,4" Margin="2" />
        </StackPanel>

        <!-- B: Content = video + sidebar -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="320" MinWidth="200" MaxWidth="500" />
            </Grid.ColumnDefinitions>

            <!-- B1: Video -->
            <Grid Grid.Column="0" Background="Black">
                <vlc:VideoView x:Name="VideoView" />
            </Grid>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                          Background="#2D2D2D" ResizeBehavior="PreviousAndNext" />

            <!-- B3: Sidebar with panel toggle -->
            <DockPanel Grid.Column="2" Background="#252526">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="#2D2D2D">
                    <Button Content="播放列表" Width="160" Padding="4" Margin="0"
                            Command="{Binding ShowPlaylistCommand}" />
                    <Button Content="笔记" Width="160" Padding="4" Margin="0"
                            Command="{Binding ShowNotesCommand}" />
                </StackPanel>

                <Grid>
                    <views:PlaylistView DataContext="{Binding Playlist}">
                        <views:PlaylistView.Visibility>
                            <Binding Path="ActivePanel" Converter="{x:Static views:PanelToVisibilityConverter.Instance}" ConverterParameter="Playlist" />
                        </views:PlaylistView.Visibility>
                    </views:PlaylistView>
                    <views:NotesView DataContext="{Binding Notes}">
                        <views:NotesView.Visibility>
                            <Binding Path="ActivePanel" Converter="{x:Static views:PanelToVisibilityConverter.Instance}" ConverterParameter="Notes" />
                        </views:NotesView.Visibility>
                    </views:NotesView>
                </Grid>
            </DockPanel>
        </Grid>

        <!-- Timeline + Status -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#2D2D2D" Padding="8,4">
                <ctrl:TimelineControl
                    PositionRatio="{Binding Player.PositionRatio, Mode=OneWay}"
                    Length="{Binding Player.Length}"
                    InPoint="{Binding Player.InPoint}"
                    OutPoint="{Binding Player.OutPoint}"
                    SeekRequested="OnTimelineSeek" />
            </Border>

            <StatusBar Grid.Row="1" Background="#007ACC" Foreground="White">
                <StatusBarItem>
                    <TextBlock Text="{Binding Player.TimeCodeDisplayString}" FontFamily="Consolas" />
                </StatusBarItem>
                <Separator Background="#3F7AB0" />
                <StatusBarItem>
                    <TextBlock Text=" / " FontFamily="Consolas" />
                </StatusBarItem>
                <StatusBarItem>
                    <TextBlock Text="{Binding Player.LengthDisplayString}" FontFamily="Consolas" />
                </StatusBarItem>
                <Separator Background="#3F7AB0" />
                <StatusBarItem>
                    <TextBlock Text="{Binding Player.Rate, StringFormat='×{0:F2}'}" FontFamily="Consolas" />
                </StatusBarItem>
                <Separator Background="#3F7AB0" />
                <StatusBarItem>
                    <TextBlock Text="{Binding Player.CurrentPath}" TextTrimming="CharacterEllipsis" />
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</Window>
