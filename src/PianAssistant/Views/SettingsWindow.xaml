<Window x:Class="PianAssistant.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 — 拉片助手"
        Width="560" Height="660"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/app.ico"
        Background="#1E1E1E" Foreground="#E0E0E0"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="Padding" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#333333" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
        <!-- Button 深色模板由 App.xaml 的 DarkButton 兜底提供（v1.3.0）：
             原此处仅覆盖颜色、沿用系统默认 Aero2 模板，悬停/按下会刷浅蓝底与浅色文字撞色 -->
    </Window.Resources>

    <DockPanel Margin="12">
        <!-- Save / Close buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存并关闭" Click="OnSave" />
        </StackPanel>

        <TabControl>
            <!-- W2-A: 通用设置 -->
            <TabItem Header="通用">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 统一数据根目录：截图/片段/数据库/日志均在此目录下自动创建子文件夹 -->
                    <Label Grid.Row="0" Content="数据目录：" />
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Text="{Binding DataRoot, Mode=TwoWay}" Margin="0,2"
                             ToolTip="所有数据（截图、片段、数据库、日志）的统一存放位置；程序将在此目录下自动创建 screenshots/、clips/ 子文件夹" />
                    <Button Grid.Row="0" Grid.Column="2" Content="浏览…"
                            Command="{Binding BrowseDataRootCommand}" />

                    <!-- 目录组织（M4）：按日期分目录 + 项目名子目录 -->
                    <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,2"
                              Content="按日期分目录（yyyyMMdd）"
                              IsChecked="{Binding OrganizeByDate, Mode=TwoWay}"
                              Foreground="#E0E0E0"
                              ToolTip="截图/片段输出到 [数据目录]\[yyyyMMdd]\ 子目录" />
                    <Label Grid.Row="2" Content="项目名：" />
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Text="{Binding ProjectSubfolderName, Mode=TwoWay}" Margin="0,2"
                             ToolTip="非空时在日期层下再加一层 [项目名] 子目录；留空不启用" />

                    <!-- 播放倍率上限：超出约4×后音频静音但视频可播 -->
                    <Label Grid.Row="3" Content="最高倍率：" />
                    <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,2"
                              ItemsSource="{Binding MaxRateOptions}"
                              SelectedItem="{Binding MaxRate, Mode=TwoWay}"
                              ToolTip="倍速上限（2×~32×）。超过约4×后音频会静音，仅视频快放" />

                    <!-- 方向键步长（M6）：帧步进 + 倍速步长 -->
                    <Label Grid.Row="4" Content="后退/快进步长：" />
                    <TextBox Grid.Row="4" Grid.Column="1"
                             Text="{Binding SeekStepFrames, Mode=TwoWay}" Margin="0,2"
                             ToolTip="方向键左右每次移动的帧数（1~600，默认 5）" />
                    <Label Grid.Row="5" Content="倍速步长：" />
                    <TextBox Grid.Row="5" Grid.Column="1"
                             Text="{Binding RateStep, Mode=TwoWay}" Margin="0,2"
                             ToolTip="方向键上下调整倍速的步长（0.05~1.0，默认 0.25）" />

                    <!-- 会话恢复开关 -->
                    <CheckBox Grid.Row="6" Grid.Column="1" Margin="0,8,0,2"
                              Content="恢复上次拉片记录"
                              IsChecked="{Binding RestoreSession, Mode=TwoWay}"
                              Foreground="#E0E0E0"
                              ToolTip="再次打开同一素材时自动还原裁切点/截图/笔记；默认开启" />
                    <CheckBox Grid.Row="7" Grid.Column="1" Margin="0,2,0,2"
                              Content="恢复播放位置与倍速"
                              IsChecked="{Binding RestorePlaybackPosition, Mode=TwoWay}"
                              Foreground="#E0E0E0"
                              ToolTip="恢复上次播放的位置与倍速；仅在「恢复上次拉片记录」开启时生效" />

                    <!-- W2-A-18 撤回步数上限（v1.6.0）：超出上限丢弃最旧记录 -->
                    <Label Grid.Row="8" Content="撤回步数上限：" />
                    <TextBox Grid.Row="8" Grid.Column="1"
                             Text="{Binding MaxUndoSteps, Mode=TwoWay}" Margin="0,2"
                             ToolTip="Ctrl+Z / ↩ 可撤回的笔记操作步数（1~50，默认 5）；超出上限自动丢弃最旧记录" />
                </Grid>
            </TabItem>

            <!-- W2-C: 输出设置（v1.5.3 从原「输出设置」拆出，区分截图与视频两组） -->
            <TabItem Header="输出">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <StackPanel>
                        <!-- 截图设置区 -->
                        <TextBlock Text="截图" FontWeight="Bold" Foreground="#E0E0E0"
                                   Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Content="截图格式：" />
                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,2"
                                      SelectedValue="{Binding SnapshotFormat, Mode=TwoWay}"
                                      SelectedValuePath="Content">
                                <ComboBoxItem Content="png" />
                                <ComboBoxItem Content="jpg" />
                            </ComboBox>
                            <!-- 截图分辨率预设（v1.4.0）：1080P 默认；长边封顶、只缩不放 -->
                            <Label Grid.Row="1" Content="截图分辨率：" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2"
                                      SelectedValue="{Binding SnapshotResolution, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      ToolTip="截图输出分辨率：1080P/720P/480P 按长边等比缩小（不放大）；「源分辨率」保持原始尺寸">
                                <ComboBoxItem Tag="source" Content="源分辨率（原图）" />
                                <ComboBoxItem Tag="1080p" Content="1080P（长边 1920）" />
                                <ComboBoxItem Tag="720p" Content="720P（长边 1280）" />
                                <ComboBoxItem Tag="480p" Content="480P（长边 854）" />
                            </ComboBox>
                        </Grid>

                        <!-- 视频设置区 -->
                        <TextBlock Text="视频" FontWeight="Bold" Foreground="#E0E0E0"
                                   Margin="0,16,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- 片段导出格式/分辨率预设（v1.4.0） -->
                            <Label Grid.Row="0" Content="视频格式：" />
                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,2"
                                      SelectedValue="{Binding VideoExportFormat, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      ToolTip="片段导出容器格式：mp4（通用）/ mkv（开放封装）/ mov（Apple）">
                                <ComboBoxItem Tag="mp4" Content="mp4（通用）" />
                                <ComboBoxItem Tag="mkv" Content="mkv（开放封装）" />
                                <ComboBoxItem Tag="mov" Content="mov（Apple）" />
                            </ComboBox>
                            <Label Grid.Row="1" Content="视频分辨率：" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2"
                                      SelectedValue="{Binding VideoExportResolution, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      ToolTip="1080P/720P/480P 会重新编码（较慢、帧级精确）；「源分辨率」使用流复制（最快、无损，起点按关键帧对齐）">
                                <ComboBoxItem Tag="source" Content="源分辨率（流复制，最快）" />
                                <ComboBoxItem Tag="1080p" Content="1080P（重编码）" />
                                <ComboBoxItem Tag="720p" Content="720P（重编码）" />
                                <ComboBoxItem Tag="480p" Content="480P（重编码）" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- W2-B: Hotkey settings -->
            <TabItem Header="快捷键">
                <DockPanel Margin="8">
                    <!-- 全局热键开关（仅注册截图键；Space 全局拦截风险大，不提供） -->
                    <CheckBox DockPanel.Dock="Top" Content="启用全局热键（应用失焦时按 X 截图）"
                              IsChecked="{Binding GlobalHotkeysEnabled, Mode=TwoWay}"
                              Margin="0,0,0,8" Foreground="#E0E0E0"
                              ToolTip="应用未获得焦点时按 X 也可截图；仅在应用有焦点外生效" />
                    <!-- Editor for selected action -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="应用" Click="OnApplyHotkey" />
                        <Button DockPanel.Dock="Right" Content="重置"
                                Command="{Binding ResetHotkeyCommand}" />
                        <Button DockPanel.Dock="Right" Content="全部重置"
                                Command="{Binding ResetAllHotkeysCommand}" />
                        <TextBox Text="{Binding EditingGesture, Mode=TwoWay}"
                                 IsReadOnly="True" Focusable="True" Margin="4,0" />
                    </DockPanel>

                    <ListBox ItemsSource="{Binding HotkeyEntries}"
                             SelectedItem="{Binding SelectedAction, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ActionLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Gesture}"
                                               FontFamily="Consolas" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
