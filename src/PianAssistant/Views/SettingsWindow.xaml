<Window x:Class="PianAssistant.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 — 拉片助手"
        Width="560" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="#E0E0E0"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="Padding" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#333333" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D2D" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="2" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <!-- Save / Close buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存并关闭" Click="OnSave" />
        </StackPanel>

        <TabControl>
            <!-- A1: Output settings -->
            <TabItem Header="输出设置">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Content="截图目录：" />
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Text="{Binding ScreenshotsDirectory, Mode=TwoWay}" Margin="0,2" />
                    <Button Grid.Row="0" Grid.Column="2" Content="浏览…"
                            Command="{Binding BrowseScreenshotsCommand}" />

                    <Label Grid.Row="1" Content="片段目录：" />
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Text="{Binding ClipsDirectory, Mode=TwoWay}" Margin="0,2" />
                    <Button Grid.Row="1" Grid.Column="2" Content="浏览…"
                            Command="{Binding BrowseClipsCommand}" />

                    <Label Grid.Row="2" Content="截图格式：" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,2"
                              SelectedItem="{Binding SnapshotFormat, Mode=TwoWay}">
                        <ComboBoxItem Content="png" />
                        <ComboBoxItem Content="jpg" />
                    </ComboBox>

                    <!-- 目录组织（M4）：按日期分目录 + 项目名子目录 -->
                    <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,6,0,2"
                              Content="按日期分目录（yyyyMMdd）"
                              IsChecked="{Binding OrganizeByDate, Mode=TwoWay}"
                              Foreground="#E0E0E0"
                              ToolTip="截图/片段输出到 [目录]\[yyyyMMdd]\ 子目录" />
                    <Label Grid.Row="4" Content="项目名：" />
                    <TextBox Grid.Row="4" Grid.Column="1"
                             Text="{Binding ProjectSubfolderName, Mode=TwoWay}" Margin="0,2"
                             ToolTip="非空时在日期层下再加一层 [项目名] 子目录；留空不启用" />
                </Grid>
            </TabItem>

            <!-- A2: Hotkey settings -->
            <TabItem Header="快捷键">
                <DockPanel Margin="8">
                    <!-- 全局热键开关（仅注册截图键；Space 全局拦截风险大，不提供） -->
                    <CheckBox DockPanel.Dock="Top" Content="启用全局热键（应用失焦时按 S 截图）"
                              IsChecked="{Binding GlobalHotkeysEnabled, Mode=TwoWay}"
                              Margin="0,0,0,8" Foreground="#E0E0E0"
                              ToolTip="应用未获得焦点时按 S 也可截图；仅在应用有焦点外生效" />
                    <!-- Editor for selected action -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="应用" Click="OnApplyHotkey" />
                        <Button DockPanel.Dock="Right" Content="重置"
                                Command="{Binding ResetHotkeyCommand}" />
                        <Button DockPanel.Dock="Right" Content="全部重置"
                                Command="{Binding ResetAllHotkeysCommand}" />
                        <TextBox Text="{Binding EditingGesture, Mode=TwoWay}"
                                 IsReadOnly="True" Focusable="True" Margin="4,0" />
                    </DockPanel>

                    <ListBox ItemsSource="{Binding HotkeyEntries}"
                             SelectedItem="{Binding SelectedAction, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Action}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Gesture}"
                                               FontFamily="Consolas" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
