<Window x:Class="PianAssistant.Views.BatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PianAssistant.Views"
        Title="批量操作 — 拉片助手"
        Width="920" Height="640" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/app.ico"
        Background="#0F0F0F" Foreground="#E8E8E8"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">

    <Window.Resources>
        <!-- 按钮基础样式（与 MainWindow/GalleryWindow 一致的深色风格） -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3D3D3D" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#505050" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#606060" />
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Background" Value="#1A6B8A" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2480A0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 深色 DataGrid 样式 -->
        <Style x:Key="DarkGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#161616" />
            <Setter Property="BorderBrush" Value="#2A2A2A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="RowBackground" Value="#1B1B1B" />
            <Setter Property="AlternatingRowBackground" Value="#1F1F1F" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#262626" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1A1A1A" />
                        <Setter Property="Foreground" Value="#999999" />
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="BorderBrush" Value="#2A2A2A" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1A6B8A" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="6,4" />
                        <Setter Property="Foreground" Value="#E8E8E8" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 顶部：载入 / 解析预览 + 统计 -->
        <Border DockPanel.Dock="Top" Background="#1A1A1A" Padding="10,8"
                BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕ 关闭" Style="{StaticResource IconButton}"
                        Click="OnClose" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📂 载入文件" Style="{StaticResource IconButton}"
                            Command="{Binding LoadFileCommand}"
                            ToolTip="从文本文件载入批量指令（每行一条）" />
                    <Button Content="🔍 解析预览" Style="{StaticResource IconButton}"
                            Command="{Binding ParseCommand}" Margin="6,0,0,0"
                            ToolTip="解析左侧文本并预览指令" />
                    <TextBlock Text="{Binding StatsText}" Foreground="#999999" FontSize="12"
                               FontFamily="Consolas" VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 底部：进度 + 执行/取消 -->
        <Border DockPanel.Dock="Bottom" Background="#1A1A1A" Padding="10,8"
                BorderBrush="#2A2A2A" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕ 取消" Style="{StaticResource IconButton}"
                        Command="{Binding CancelCommand}" Margin="6,0,0,0"
                        ToolTip="取消当前批量执行" />
                <Button DockPanel.Dock="Right" Content="▶ 执行" Style="{StaticResource AccentButton}"
                        Command="{Binding ExecuteCommand}"
                        ToolTip="执行：标记/裁切点写入笔记与时间轴，截图/片段经 ffmpeg 导出" />
                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                    <ProgressBar Height="6" Minimum="0" Maximum="100"
                                 Value="{Binding Progress, Mode=OneWay}"
                                 Background="#2A2A2A" Foreground="#1A6B8A" BorderThickness="0" />
                    <TextBlock Text="{Binding StatusText}" Foreground="#999999" FontSize="11"
                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 主体：左文本 / 右预览-结果 -->
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="1.5*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- 左：指令文本 -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Foreground="#888888" FontSize="11" Margin="0,0,0,4">
                    <Run Text="指令文本（每行一条）：" /><LineBreak />
                    <Run Text="00:01:23 截图 标签 · 00:01:00-00:02:30 片段 标签" Foreground="#5A5A5A" /><LineBreak />
                    <Run Text="00:01:00 标记 笔记文本 · 00:04:20（裁切点）" Foreground="#5A5A5A" />
                </TextBlock>
                <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12"
                         Background="#161616" Foreground="#E8E8E8" BorderBrush="#2A2A2A"
                         Padding="6" CaretBrush="#E8E8E8"
                         ToolTip="粘贴批量清单；# 或 // 开头为注释行" />
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" Background="#1A1A1A"
                          ResizeBehavior="PreviousAndNext" />

            <!-- 右：解析预览 / 执行结果（执行后切换） -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Foreground="#888888" FontSize="11" Margin="0,0,0,4">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="解析预览" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowResults}" Value="True">
                                    <Setter Property="Text" Value="执行结果" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Grid>
                    <!-- 预览 DataGrid -->
                    <DataGrid ItemsSource="{Binding Items}" Style="{StaticResource DarkGrid}"
                              Visibility="{Binding ShowResults, Converter={x:Static views:InverseBoolToVisibilityConverter.Instance}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="行" Binding="{Binding LineNumber}" Width="40" />
                            <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="56" />
                            <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas" />
                                        <Setter Property="Foreground" Value="#CE9178" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="标签" Binding="{Binding Label}" Width="*" />
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusIcon}" Width="40">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                <Setter Property="Foreground" Value="#E04B4B" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="错误" Binding="{Binding Error}" Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#E04B4B" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding Error}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 结果 DataGrid -->
                    <DataGrid ItemsSource="{Binding Results}" Style="{StaticResource DarkGrid}"
                              Visibility="{Binding ShowResults, Converter={x:Static views:BoolToVisibilityConverter.Instance}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusIcon}" Width="40">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Success}" Value="False">
                                                <Setter Property="Foreground" Value="#E04B4B" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="输出" Binding="{Binding DetailText}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding DetailText}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="耗时" Binding="{Binding ElapsedText}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas" />
                                        <Setter Property="Foreground" Value="#4EC9B0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="错误" Binding="{Binding Error}" Width="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#E04B4B" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding Error}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
