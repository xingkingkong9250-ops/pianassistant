<UserControl x:Class="PianAssistant.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:PianAssistant.Models"
             xmlns:views="clr-namespace:PianAssistant.Views"
             Background="#161616"
             Foreground="#E8E8E8">

    <UserControl.Resources>
        <!-- ListBox 项容器：透明背景、IsSelected 双向同步条目选中态 -->
        <Style x:Key="TimelineListBoxItem" TargetType="ListBoxItem">
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" Padding="0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 截图条目模板：绿框 + 📷 + 缩略图 + 名称/时间 -->
        <DataTemplate DataType="{x:Type models:ScreenshotListItem}">
            <Border Margin="8,3" Padding="4" CornerRadius="4"
                    Background="#1F1F1F" BorderBrush="{Binding AccentColor}" BorderThickness="1.5"
                    MouseLeftButtonDown="OnItemJumpClick" Cursor="Hand">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="📂 打开所在文件夹" Click="OnScreenshotOpenFolder" />
                        <MenuItem Header="✏ 标注" Click="OnScreenshotAnnotate" />
                        <MenuItem Header="🗑 删除" Click="OnScreenshotDelete" />
                    </ContextMenu>
                </Border.ContextMenu>
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="6,0,2,0" Focusable="False"
                              ToolTip="勾选标记为「已选中」，供导出选中 / 批量导出使用" />
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" FontSize="14"
                               VerticalAlignment="Center" Margin="2,0,6,0" />
                    <Border DockPanel.Dock="Left" Width="120" Height="68" ClipToBounds="True"
                            CornerRadius="2" Background="#000000">
                        <Image Source="{Binding Entry.OutputPath, Converter={x:Static views:ThumbnailConverter.Instance}}"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Margin="8,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="12" Foreground="#E8E8E8" />
                        <TextBlock Text="{Binding TimeText}" FontFamily="Consolas" FontSize="11"
                                   Foreground="{Binding AccentColor}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- 片段条目模板：黄框 + 🎬 + 段起始帧缩略图（异步补抽） + 名称·时长/起始时间 -->
        <DataTemplate DataType="{x:Type models:SegmentListItem}">
            <Border Margin="8,3" Padding="4" CornerRadius="4"
                    Background="#1F1F1F" BorderBrush="{Binding AccentColor}" BorderThickness="1.5"
                    MouseLeftButtonDown="OnItemJumpClick" Cursor="Hand">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="📤 导出此段" Click="OnSegmentExport" />
                        <MenuItem Header="▶ 跳转播放" Click="OnSegmentJump" />
                    </ContextMenu>
                </Border.ContextMenu>
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="6,0,2,0" Focusable="False"
                              ToolTip="勾选标记为「已选中」，供导出选中 / 批量导出使用" />
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" FontSize="14"
                               VerticalAlignment="Center" Margin="2,0,6,0" />
                    <Border DockPanel.Dock="Left" Width="120" Height="68" ClipToBounds="True"
                            CornerRadius="2" Background="#000000">
                        <Image Source="{Binding ThumbnailPath, Converter={x:Static views:ThumbnailConverter.Instance}}"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Margin="8,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="12" Foreground="#E8E8E8" />
                        <TextBlock Text="{Binding TimeText}" FontFamily="Consolas" FontSize="11"
                                   Foreground="{Binding AccentColor}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- 裁切点条目模板：红色细条行（无缩略图），选中后可删除合并相邻片段 -->
        <DataTemplate DataType="{x:Type models:CutPointListItem}">
            <Border Margin="8,1" Padding="4,2" CornerRadius="3"
                    Background="#1A1A1A" BorderBrush="{Binding AccentColor}" BorderThickness="1">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="🗑 删除（合并相邻片段）" Click="OnCutPointDelete" />
                    </ContextMenu>
                </Border.ContextMenu>
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="3" Margin="0,0,6,0"
                            Background="{Binding AccentColor}" CornerRadius="1" />
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Title}" FontSize="11" VerticalAlignment="Center"
                               Foreground="{Binding AccentColor}" />
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- W1-C2-D-01 筛选栏：常用 chip + 更多筛选下拉 -->
        <Border DockPanel.Dock="Top" Background="#1A1A1A" Padding="6,5"
                BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ChipAll" Content="全部" Padding="10,3" FontSize="12"
                        Background="#1A6B8A" Foreground="#E8E8E8" BorderThickness="0"
                        Cursor="Hand" Focusable="False" Click="OnFilterAll" />
                <Button x:Name="ChipScreenshots" Content="📷 截图" Padding="10,3" FontSize="12"
                        Margin="6,0,0,0" Background="Transparent" Foreground="#888888"
                        BorderThickness="0" Cursor="Hand" Focusable="False" Click="OnFilterScreenshots" />
                <Button x:Name="ChipSegments" Content="🎬 片段" Padding="10,3" FontSize="12"
                        Margin="6,0,0,0" Background="Transparent" Foreground="#888888"
                        BorderThickness="0" Cursor="Hand" Focusable="False" Click="OnFilterSegments" />
                <Button x:Name="ChipSelected" Content="✔ 已选中" Padding="10,3" FontSize="12"
                        Margin="6,0,0,0" Background="Transparent" Foreground="#888888"
                        BorderThickness="0" Cursor="Hand" Focusable="False" Click="OnFilterSelected" />
                <Button x:Name="ChipMore" Content="更多筛选 ▾" Padding="10,3" FontSize="12"
                        Margin="6,0,0,0" Background="Transparent" Foreground="#888888"
                        BorderThickness="0" Cursor="Hand" Focusable="False" Click="OnMoreFilters"
                        ToolTip="更多筛选条件">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="MoreFilterMenu">
                            <MenuItem Header="✂ 仅裁切点" Click="OnFilterCutPointsOnly" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Border>

        <!-- W1-C2-D-02 工具栏：导出选中 -->
<!-- 旧工具栏按钮（画廊 / 裁切点导入导出 / 批量导出）已从界面移除，功能与处理器保留备份，需要时取消注释复用：
<Button Content="🖼 画廊" Padding="8,3" FontSize="12"
        Background="Transparent" Foreground="#CCCCCC" BorderThickness="0"
        Cursor="Hand" Focusable="False" Click="OnOpenGallery"
        ToolTip="打开截图画廊（网格浏览 / 大图翻页 / 标注）" />
<Button Content="⬆ 导入裁切" Padding="8,3" FontSize="12"
        Background="Transparent" Foreground="#CCCCCC" BorderThickness="0"
        Cursor="Hand" Focusable="False" Click="OnImportCutPoints"
        ToolTip="从文本清单导入裁切点（将替换现有裁切点）" />
<Button Content="⬇ 导出裁切" Padding="8,3" FontSize="12"
        Background="Transparent" Foreground="#CCCCCC" BorderThickness="0"
        Cursor="Hand" Focusable="False" Click="OnExportCutPoints"
        ToolTip="导出裁切点清单（自动生成片段行）" />
<Button Content="📦 批量导出" Padding="8,3" FontSize="12"
        Background="Transparent" Foreground="#CCCCCC" BorderThickness="0"
        Cursor="Hand" Focusable="False" Click="OnOpenClipsPanel"
        ToolTip="打开片段批量导出面板（队列进度 / 拼接）" />
-->
        <Border DockPanel.Dock="Top" Background="#1A1A1A" Padding="6,5"
                BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="📤 导出选中" Padding="8,3" FontSize="12"
                        Background="Transparent" Foreground="#D7BA7D" BorderThickness="0"
                        Cursor="Hand" Focusable="False"
                        Command="{Binding ExportSelectedCommand}"
                        ToolTip="把选中的截图（复制 png）与片段（ffmpeg 切出 mp4）导出到指定目录" />
            </StackPanel>
        </Border>

        <!-- W1-C2-D-03 统一时间线列表：Extended 多选（Ctrl/Shift），Delete 键删除选中裁切点 -->
        <ListBox ItemsSource="{Binding FilteredItems}"
                 SelectionMode="Extended"
                 ItemContainerStyle="{StaticResource TimelineListBoxItem}"
                 Background="Transparent" BorderThickness="0" Margin="0,4"
                 KeyDown="OnListKeyDown"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling" />
    </DockPanel>
</UserControl>
