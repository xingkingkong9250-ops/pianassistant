<UserControl x:Class="PianAssistant.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:PianAssistant.Models"
             xmlns:views="clr-namespace:PianAssistant.Views"
             Background="#161616"
             Foreground="#E8E8E8">

    <UserControl.Resources>
        <!-- 截图缩略图模板 -->
        <DataTemplate x:Key="ScreenshotTemplate" DataType="{x:Type models:ScreenshotEntry}">
            <Border Margin="8,3" Padding="0" CornerRadius="4"
                    Background="#1F1F1F" BorderBrush="#2A2A2A" BorderThickness="1"
                    MouseLeftButtonDown="OnScreenshotClick" Cursor="Hand">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="📂 打开所在文件夹" Click="OnScreenshotOpenFolder" />
                        <MenuItem Header="✏ 标注" Click="OnScreenshotAnnotate" />
                        <MenuItem Header="🗑 删除" Click="OnScreenshotDelete" />
                    </ContextMenu>
                </Border.ContextMenu>
                <DockPanel>
                    <!-- 缩略图 -->
                    <Border DockPanel.Dock="Left" Width="120" Height="68" Margin="0" ClipToBounds="True"
                            Background="#000000">
                        <Image Source="{Binding OutputPath}" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <!-- 信息 -->
                    <StackPanel Margin="8,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Position, StringFormat='mm\\:ss\\.fff'}"
                                   FontFamily="Consolas" FontSize="12" Foreground="#4EC9B0" />
                        <TextBlock Text="{Binding CapturedAt, StringFormat='HH:mm:ss'}"
                                   FontFamily="Consolas" FontSize="10" Foreground="#666666"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- 片段段模板 -->
        <DataTemplate x:Key="SegmentTemplate" DataType="{x:Type models:TimelineSegment}">
            <Border Margin="8,3" Padding="8,6" CornerRadius="4"
                    Background="#1F1F1F" BorderBrush="#2A2A2A" BorderThickness="1"
                    MouseLeftButtonDown="OnSegmentClick" Cursor="Hand">
                <DockPanel>
                    <!-- 导出按钮 -->
                    <Button DockPanel.Dock="Right" Content="📤" Padding="4" Margin="4,0"
                            FontSize="13" Background="Transparent" Foreground="#888888"
                            BorderThickness="0" Cursor="Hand" Focusable="False"
                            Click="OnSegmentExport" ToolTip="导出此段" />
                    <!-- 编号 -->
                    <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="4"
                            Background="#1A6B8A" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Index}" Foreground="White" FontWeight="SemiBold"
                                   FontFamily="Consolas" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <!-- 信息 -->
                    <StackPanel VerticalAlignment="Center">
                        <DockPanel>
                            <TextBlock Text="{Binding StartText}" FontFamily="Consolas" FontSize="11"
                                       Foreground="#CE9178" />
                            <TextBlock Text=" → " FontFamily="Consolas" FontSize="11"
                                       Foreground="#666666" />
                            <TextBlock Text="{Binding EndText}" FontFamily="Consolas" FontSize="11"
                                       Foreground="#CE9178" />
                        </DockPanel>
                        <TextBlock Text="{Binding Summary}" FontFamily="Consolas" FontSize="11"
                                   Foreground="#888888" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- 活动条目模板：查看态 + 内联编辑态，右键菜单（编辑/删除） -->
        <DataTemplate x:Key="ActivityTemplate" DataType="{x:Type models:ActivityEntry}">
            <Border Margin="8,3" Padding="8,6" CornerRadius="4"
                    Background="#1F1F1F" BorderBrush="#2A2A2A" BorderThickness="1">
                <Border.ContextMenu>
                    <ContextMenu>
                        <!-- 编辑仅对笔记类型显示 -->
                        <MenuItem Header="✏ 编辑" Click="OnActivityEdit">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="Note">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <MenuItem Header="🗑 删除" Click="OnActivityDelete" />
                    </ContextMenu>
                </Border.ContextMenu>
                <!-- 查看态（点击跳转）+ 编辑态（内联 TextBox）切换 -->
                <Grid>
                    <StackPanel Visibility="{Binding IsEditing, Converter={x:Static views:InverseBoolToVisibilityConverter.Instance}}"
                                MouseLeftButtonDown="OnActivityClick" Cursor="Hand">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding TypeIcon}" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PositionText}" FontFamily="Consolas"
                                       FontSize="11" Foreground="{Binding TypeColor}" Margin="6,0,0,0" />
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="12" />
                        </DockPanel>
                    </StackPanel>
                    <!-- 编辑态：内联 TextBox，Enter 提交 / Esc 取消 -->
                    <TextBox Visibility="{Binding IsEditing, Converter={x:Static views:BoolToVisibilityConverter.Instance}}"
                             Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                             IsVisibleChanged="OnActivityEditBoxVisible"
                             KeyDown="OnActivityEditKeyDown"
                             LostFocus="OnActivityEditLostFocus"
                             Background="#111111" Foreground="#E8E8E8" BorderBrush="#1A6B8A"
                             Padding="2,2" FontSize="12" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- 顶部子标签栏 -->
        <Border DockPanel.Dock="Top" Background="#1A1A1A" Padding="0"
                BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="📷 截图" Padding="0,8" FontSize="13"
                        Background="Transparent" Foreground="#E8E8E8" BorderThickness="0,0,1,0"
                        BorderBrush="#2A2A2A" Cursor="Hand" Focusable="False"
                        Click="OnShowScreenshots" x:Name="BtnScreenshots" />
                <Button Grid.Column="1" Content="✂ 片段" Padding="0,8" FontSize="13"
                        Background="Transparent" Foreground="#888888" BorderThickness="0,1,1,0"
                        BorderBrush="#2A2A2A" Cursor="Hand" Focusable="False"
                        Click="OnShowSegments" x:Name="BtnSegments" />
                <Button Grid.Column="2" Content="📝 活动" Padding="0,8" FontSize="13"
                        Background="Transparent" Foreground="#888888" BorderThickness="0"
                        Cursor="Hand" Focusable="False"
                        Click="OnShowActivities" x:Name="BtnActivities" />
            </Grid>
        </Border>

        <!-- 截图面板 -->
        <DockPanel x:Name="ScreenshotsPanel" Background="#161616">
            <!-- 顶部：画廊入口 -->
            <Border DockPanel.Dock="Top" Background="#1A1A1A" Padding="8,5"
                    BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="🖼 画廊" Padding="8,3"
                            Background="Transparent" Foreground="#CCCCCC" BorderThickness="0"
                            Cursor="Hand" Focusable="False" Click="OnOpenGallery"
                            ToolTip="打开截图画廊（网格浏览 / 大图翻页 / 标注）" />
                    <TextBlock Text="截图" Foreground="#888888" FontSize="12"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Screenshots}"
                              ItemTemplate="{StaticResource ScreenshotTemplate}"
                              Margin="0,4" />
            </ScrollViewer>
        </DockPanel>

        <!-- 片段面板（默认隐藏） -->
        <DockPanel x:Name="SegmentsPanel" Background="#161616" Visibility="Collapsed">
            <!-- 顶部：批量导出面板入口 -->
            <Border DockPanel.Dock="Top" Background="#1A1A1A" Padding="8,5"
                    BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="📦 批量导出" Padding="8,3"
                            Background="Transparent" Foreground="#CCCCCC" BorderThickness="0"
                            Cursor="Hand" Focusable="False" Click="OnOpenClipsPanel"
                            ToolTip="打开片段批量导出面板（队列进度 / 拼接）" />
                    <TextBlock Text="分段" Foreground="#888888" FontSize="12"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Segments}"
                              ItemTemplate="{StaticResource SegmentTemplate}"
                              Margin="0,4" />
            </ScrollViewer>
        </DockPanel>

        <!-- 活动流面板（默认隐藏） -->
        <DockPanel x:Name="ActivitiesPanel" Visibility="Collapsed" Background="#161616">
            <!-- 底部笔记输入区：模板下拉 + 输入框 -->
            <Border DockPanel.Dock="Bottom" Background="#1A1A1A" Padding="8,6"
                    BorderBrush="#2A2A2A" BorderThickness="0,1,0,0">
                <StackPanel>
                    <ComboBox x:Name="TemplateCombo" Margin="0,0,0,6"
                              ItemsSource="{Binding TemplateOptions}"
                              SelectedItem="{Binding ActiveTemplate, Mode=TwoWay}"
                              ToolTip="笔记模板：添加笔记时自动附加分类前缀" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="添加" Padding="10,0" Margin="6,0,0,0"
                                Background="#1A6B8A" Foreground="White" BorderThickness="0"
                                Cursor="Hand" Focusable="False"
                                Click="OnAddNote" ToolTip="添加笔记（Enter）" />
                        <TextBox x:Name="NoteInput" Text="{Binding NewNoteText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnNoteInputKeyDown" VerticalContentAlignment="Center"
                                 Background="#1F1F1F" Foreground="#E8E8E8" BorderBrush="#2A2A2A"
                                 Padding="4,4" ToolTip="输入笔记，回车添加" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- 顶部：搜索 + 时间范围 + 导出 -->
            <Border DockPanel.Dock="Top" Background="#1A1A1A" Padding="8,6"
                    BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="📤 导出" Padding="8,4" Margin="6,0,0,0"
                                Background="Transparent" Foreground="#CCCCCC" BorderThickness="0"
                                Cursor="Hand" Focusable="False"
                                Command="{Binding ExportCommand}"
                                ToolTip="导出活动流（.md=Markdown / .txt=纯文本）" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 Background="#1F1F1F" Foreground="#E8E8E8" BorderBrush="#2A2A2A"
                                 Padding="4,4" ToolTip="搜索活动流" />
                    </DockPanel>
                    <!-- 时间范围筛选（留空不限） -->
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="范围" Foreground="#666666"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="RangeStartInput" Width="80" TextChanged="OnRangeStartChanged"
                                 VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="11"
                                 Background="#1F1F1F" Foreground="#E8E8E8" BorderBrush="#2A2A2A"
                                 Padding="4,2" Margin="0,0,6,0"
                                 ToolTip="开始时间（mm:ss 或 hh:mm:ss），留空不限" />
                        <TextBlock DockPanel.Dock="Left" Text="—" Foreground="#666666"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="RangeEndInput" TextChanged="OnRangeEndChanged"
                                 VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="11"
                                 Background="#1F1F1F" Foreground="#E8E8E8" BorderBrush="#2A2A2A"
                                 Padding="4,2"
                                 ToolTip="结束时间（mm:ss 或 hh:mm:ss），留空不限" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- 活动列表（按搜索/范围过滤） -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredActivities}"
                              ItemTemplate="{StaticResource ActivityTemplate}"
                              Margin="0,4" />
            </ScrollViewer>
        </DockPanel>
    </DockPanel>
</UserControl>
