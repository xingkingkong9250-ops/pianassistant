<Window x:Class="PianAssistant.Views.AnnotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="标注编辑 — 拉片助手"
        Width="1080" Height="760" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/app.ico"
        Background="#0F0F0F" Foreground="#E8E8E8"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,7" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3D3D3D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#505050" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style x:Key="ColorButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Padding" Value="2,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ═══ 底部操作栏 ═══ -->
        <Border DockPanel.Dock="Bottom" Background="#1A1A1A" Padding="12,8"
                BorderBrush="#2A2A2A" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnConfirmCrop" Content="✂ 确认裁剪" Click="OnConfirmCrop"
                            Style="{StaticResource ActionButton}" Visibility="Collapsed"
                            Background="#1A6B8A" Foreground="White"
                            ToolTip="以当前红框为界裁剪输出" />
                    <Button Content="💾 保存为副本" Click="OnSave" Style="{StaticResource ActionButton}"
                            Background="#1A6B8A" Foreground="White"
                            ToolTip="渲染标注层合成新图（原名_annotated.png），不修改原图" />
                    <Button Content="取消" Click="OnCancel" Style="{StaticResource ActionButton}" />
                </StackPanel>
                <TextBlock x:Name="HintText" Text="" Foreground="#888888"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- ═══ 左侧工具栏 ═══ -->
        <Border DockPanel.Dock="Left" Width="86" Background="#161616"
                BorderBrush="#2A2A2A" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,8">
                    <TextBlock Text="模式" Foreground="#666666" FontSize="11"
                               Margin="8,0,0,4" />
                    <Button x:Name="BtnSelect" Content="⬚ 选择" Click="OnModeSelect"
                            Style="{StaticResource ToolButton}" ToolTip="选择 / 移动 / 缩放笔迹" />
                    <Button x:Name="BtnPen" Content="✎ 画笔" Click="OnModePen"
                            Style="{StaticResource ToolButton}" ToolTip="画笔（InkCanvas）" />
                    <Button x:Name="BtnArrow" Content="➤ 箭头" Click="OnModeArrow"
                            Style="{StaticResource ToolButton}" ToolTip="按下起点拖到终点释放" />
                    <Button x:Name="BtnText" Content="🅣 文字" Click="OnModeText"
                            Style="{StaticResource ToolButton}" ToolTip="点击位置输入文字" />
                    <Button x:Name="BtnCrop" Content="✂ 裁剪" Click="OnModeCrop"
                            Style="{StaticResource ToolButton}" ToolTip="拖出矩形后确认裁剪" />

                    <Separator Margin="4,10" Background="#2A2A2A" />
                    <TextBlock Text="颜色" Foreground="#666666" FontSize="11"
                               Margin="8,0,0,4" />
                    <Button x:Name="BtnRed" Content="●" Foreground="#E5484D" Click="OnColorRed"
                            Style="{StaticResource ColorButton}" ToolTip="红色" />
                    <Button x:Name="BtnYellow" Content="●" Foreground="#F5C518" Click="OnColorYellow"
                            Style="{StaticResource ColorButton}" ToolTip="黄色" />
                    <Button x:Name="BtnBlue" Content="●" Foreground="#3B9EFF" Click="OnColorBlue"
                            Style="{StaticResource ColorButton}" ToolTip="蓝色" />
                    <Button x:Name="BtnWhite" Content="●" Foreground="#FFFFFF" Click="OnColorWhite"
                            Style="{StaticResource ColorButton}" ToolTip="白色" />

                    <Separator Margin="4,10" Background="#2A2A2A" />
                    <TextBlock Text="粗细" Foreground="#666666" FontSize="11"
                               Margin="8,0,0,4" />
                    <Button x:Name="BtnThin" Content="细" Click="OnThicknessThin"
                            Style="{StaticResource ToolButton}" ToolTip="细（2px）" />
                    <Button x:Name="BtnMedium" Content="中" Click="OnThicknessMedium"
                            Style="{StaticResource ToolButton}" ToolTip="中（4px）" />
                    <Button x:Name="BtnThick" Content="粗" Click="OnThicknessThick"
                            Style="{StaticResource ToolButton}" ToolTip="粗（8px）" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══ 画布区：Viewbox 缩放到适配，坐标系 = 图像像素 ═══ -->
        <Grid Margin="8">
            <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid x:Name="CanvasGrid" Background="#202020">
                    <!-- 底图 -->
                    <Image x:Name="BaseImage" Stretch="Fill" />
                    <!-- 笔迹层 -->
                    <InkCanvas x:Name="AnnotationInk" Background="{x:Null}" />
                    <!-- 形状层：箭头 / 文字 / 裁剪框 -->
                    <Canvas x:Name="ShapeCanvas" Background="Transparent"
                            MouseLeftButtonDown="OnShapeCanvasMouseDown"
                            MouseMove="OnShapeCanvasMouseMove"
                            MouseLeftButtonUp="OnShapeCanvasMouseUp" />
                </Grid>
            </Viewbox>
        </Grid>
    </DockPanel>
</Window>
