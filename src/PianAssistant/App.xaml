<Application x:Class="PianAssistant.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <Application.Resources>

        <!-- ═══ 全局深色主题：弹出类控件统一配色 ═══
             问题背景：ComboBox 弹出层 / ContextMenu / TabControl / ListBox 使用 WPF
             默认浅色模板，而各窗口背景为深色且 Foreground 继承浅灰（#E8E8E8），
             形成"白底浅字"撞色导致信息不可读（如倍速下拉框）。
             此处统一：弹层底 #252526、文字 #E0E0E0、强调 #1A6B8A。
             setter-only 样式保留系统模板（仅覆盖颜色）；ComboBox / TabItem 因默认
             模板硬编码浅色，必须提供完整深色模板。 -->

        <!-- ComboBox：完整深色模板（默认模板弹出层白底 + 浅字撞色，无法仅靠颜色覆盖修复） -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="Padding" Value="6,4,22,4" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="#333333" BorderBrush="#3F3F46"
                                                BorderThickness="1" CornerRadius="3">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,7,0" Data="M 0 0 L 4 4 L 8 0"
                                                  Stroke="#CCCCCC" StrokeThickness="1.5" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#3D3D3D" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <Popup x:Name="Popup" Placement="Bottom" Focusable="False"
                                   AllowsTransparency="True" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="1"
                                        CornerRadius="3" Margin="0,2,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem：深底浅字；悬停/选中用强调色保证可读 -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A6B8A" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#144D63" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ContextMenu / MenuItem：深底浅字（保留系统模板，仅覆盖颜色；
             悬停高亮仍为系统蓝底白字，可读） -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#252526" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="Foreground" Value="#E0E0E0" />
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E0E0E0" />
        </Style>

        <!-- ListBox：默认白底改为深色（仅影响未显式设背景的列表，如设置窗快捷键列表） -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="BorderBrush" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#E0E0E0" />
        </Style>

        <!-- TabControl / TabItem：设置窗页签深色化（与主窗口导航标签风格一致） -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#999999" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="14,8">
                            <Grid>
                                <ContentPresenter x:Name="HeaderSite" ContentSource="Header"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Rectangle x:Name="Underline" Height="2" VerticalAlignment="Bottom"
                                           Fill="#1A6B8A" RadiusX="1" RadiusY="1" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="#E8E8E8" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A" />
                                <Setter Property="Foreground" Value="#E0E0E0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
